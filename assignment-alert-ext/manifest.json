{
    "manifest_version": 3,
    "name": "Assignment Alert",
    "version": "1.0",
    "action": {
        "default_popup": "index.html"
    },
    "permissions": [
        "storage",
        "notifications",
        "alarms"
    ],
    "host_permissions": [
        "http://localhost:8080/*"
    ],
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    }
}