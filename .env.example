DB_HOST=localhost
DB_PORT=5332
DB_NAME=assignment_alert
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assignment_alert

# Must match the region in your IAM policy ARN.
# Do not change it after users have connected - their tokens live in this region only.
AWS_REGION=us-east-1

APP_CORS_ALLOWED_ORIGINS=chrome-extension://your-extension-id

# Optional. Restricts which Canvas hosts the server will contact, as a comma-separated
# list of domain suffixes. Empty allows any public host.
APP_CANVAS_ALLOWED_DOMAIN_SUFFIXES=

# Optional. How long an issued session token stays valid. Defaults to 30.
APP_TOKEN_TTL_DAYS=30

# Optional. Set to "framework" ONLY when the backend sits behind a reverse proxy you
# control, so rate limits count the real client instead of the proxy. Leave as "none"
# when the backend is reachable directly - otherwise anyone can forge X-Forwarded-For
# and bypass the limits.
SERVER_FORWARD_HEADERS_STRATEGY=none
